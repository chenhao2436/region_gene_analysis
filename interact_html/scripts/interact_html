#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
生成时间: 2026-04-13
脚本名称: interact_html
脚本作用:
1. 读取多个 BSA snpindex/plot.tsv 结果文件。
2. 按 bsa.fig.py -snpindex 的绘图逻辑，把每条染色体按原始顺序累加到同一条 x 轴上。
3. 使用 Plotly 生成交互式 HTML，鼠标悬停到点上显示样本名、染色体、位置、DELTA 值、SNP 数量。
4. SNP 数量按每个样本 90% 分位数截断后映射到 plasma_r 色阶，避免极端值把颜色压成一团。
5. 不绘制 ED threshold 红线，不绘制 Share Peak 背景块，尽量保持原静态图排版。

输入:
  --plot-tsv       一个或多个 snpindex/plot.tsv 文件，至少需要列 0/1/5/6 或末列。
  --sample-labels  样本显示名，数量需要与 --plot-tsv 一致。
  --output-dir     HTML 输出目录。

输出:
  bsa_interactive_combined.html
  bsa_interactive_subplots.html
  bsa_interactive_<sample>.html

使用方法:
  python interact_html \
    --plot-tsv a.plot.tsv b.plot.tsv \
    --sample-labels 301 168 \
    --output-dir ./output
"""

import argparse as _argparse
import csv as _csv
import os as _os
import re as _re
import sys as _sys

from typing import Dict as _Dict
from typing import List as _List
from typing import Tuple as _Tuple

import numpy as _np

try:
    import plotly.graph_objects as _go
    from plotly.subplots import make_subplots as _make_subplots
except ImportError:
    print("[ERROR] 必须安装 plotly。请先执行: pip install plotly", file=_sys.stderr)
    _sys.exit(1)


_COLORSCALE = "Plasma_r"
_SAMPLE_RE = _re.compile(r"joint_(\d+)_|(\d+)_new")


def _parse_args():
    parser = _argparse.ArgumentParser(
        description="按 bsa.fig.py -snpindex 版式生成交互式 BSA HTML"
    )
    parser.add_argument("--plot-tsv", nargs="+", required=True, help="一个或多个 plot.tsv/snpindex 文件")
    parser.add_argument("--output-dir", required=True, help="HTML 输出目录")
    parser.add_argument("--sample-labels", nargs="+", help="样本显示名，数量必须与 --plot-tsv 一致")
    # 兼容旧命令；本版按用户要求不再绘制 Share Peak 背景块。
    parser.add_argument("--cluster-tsv", default="", help=_argparse.SUPPRESS)
    parser.add_argument("--min-cluster-support", type=int, default=2, help=_argparse.SUPPRESS)
    return parser.parse_args()


def _infer_sample_name(path: str) -> str:
    base = _os.path.basename(path)
    if "301_new_genome_joint_F2" in base:
        return "F2_Canz_3MB"
    match = _SAMPLE_RE.search(base)
    if match:
        return match.group(1) or match.group(2)
    return base.replace(".plot.tsv", "").replace(".tsv", "").replace(".snpindex", "")


def _sanitize_filename(name: str) -> str:
    safe = _re.sub(r"[^\w.-]+", "_", name.strip(), flags=_re.UNICODE).strip("_")
    return safe or "sample"


def _chrom_sort_key(chrom: str):
    nums = _re.findall(r"\d+", chrom)
    if nums:
        return (0, int(nums[0]), chrom)
    return (1, chrom)


def _parse_int_like(value: str) -> int:
    return int(float(value))


def _parse_float_like(value: str) -> float:
    return float(value)


def _get_snp_n(row: _List[str]) -> int:
    """plot.tsv 通常第 6 列是 SNP_N；兼容末列也是 SNP_N 的 snpindex 文件。"""
    for idx in (-1, 6):
        try:
            return _parse_int_like(row[idx])
        except (IndexError, ValueError):
            continue
    raise ValueError("cannot parse SNP_N")


def _load_snpindex_data(path: str, sample: str) -> _Dict:
    by_chrom: _Dict[str, _List[_Dict]] = {}
    snp_values: _List[int] = []

    with open(path, "r", encoding="utf-8") as handle:
        reader = _csv.reader(handle, delimiter="\t")
        for row in reader:
            if not row or row[0].startswith("#") or row[0] == "CHROM":
                continue
            if len(row) < 7:
                continue

            try:
                chrom = row[0]
                pos = _parse_int_like(row[1])
                delta = _parse_float_like(row[5])
                snp_n = _get_snp_n(row)
            except ValueError:
                continue

            if _np.isnan(delta):
                continue

            point = {"chrom": chrom, "pos": pos, "delta": delta, "snp": snp_n}
            by_chrom.setdefault(chrom, []).append(point)
            snp_values.append(snp_n)

    if not snp_values:
        raise ValueError(f"{path} 没有读到可绘图的数据，请检查列 0/1/5/6 是否存在。")

    snp_cap = float(_np.percentile(snp_values, 90))
    if snp_cap <= 0:
        snp_cap = float(max(snp_values) or 1)

    return {
        "sample": sample,
        "path": path,
        "by_chrom": by_chrom,
        "snp_cap": snp_cap,
        "point_count": len(snp_values),
    }


def _build_chrom_axes(samples: _List[_Dict], use_global_lengths: bool) -> _Tuple[_List[str], _Dict[str, int], _Dict[str, int], _List[float], _List[str], int]:
    chroms = sorted(
        {chrom for sample in samples for chrom in sample["by_chrom"].keys()},
        key=_chrom_sort_key,
    )

    chrom_lengths: _Dict[str, int] = {}
    for chrom in chroms:
        lengths = []
        for sample in samples:
            points = sample["by_chrom"].get(chrom, [])
            if points:
                # bsa.fig.py 使用该染色体最后一个窗口位置作为该染色体长度。
                lengths.append(points[-1]["pos"])
        if use_global_lengths:
            chrom_lengths[chrom] = max(lengths)
        else:
            chrom_lengths[chrom] = lengths[0]

    chrom_offsets: _Dict[str, int] = {}
    tick_vals: _List[float] = []
    tick_texts: _List[str] = []
    start = 0
    for chrom in chroms:
        length = chrom_lengths[chrom]
        chrom_offsets[chrom] = start
        tick_vals.append(start + length / 2)
        tick_texts.append(chrom)
        start += length

    return chroms, chrom_lengths, chrom_offsets, tick_vals, tick_texts, start


def _build_plot_arrays(sample: _Dict, chroms: _List[str], chrom_offsets: _Dict[str, int]) -> _Dict:
    x_values: _List[float] = []
    y_values: _List[float] = []
    color_values: _List[float] = []
    hover_texts: _List[str] = []

    for chrom in chroms:
        offset = chrom_offsets[chrom]
        for point in sample["by_chrom"].get(chrom, []):
            snp_for_color = min(float(point["snp"]), sample["snp_cap"])
            x_values.append(offset + point["pos"])
            y_values.append(point["delta"])
            color_values.append(snp_for_color)
            hover_texts.append(
                "Sample: {sample}<br>"
                "Chrom: {chrom}<br>"
                "Pos: {pos:,} bp<br>"
                "DELTA: {delta:.6g}<br>"
                "SNP N: {snp}".format(
                    sample=sample["sample"],
                    chrom=point["chrom"],
                    pos=point["pos"],
                    delta=point["delta"],
                    snp=point["snp"],
                )
            )

    return {
        "x": x_values,
        "y": y_values,
        "color": color_values,
        "hover": hover_texts,
    }


def _marker_style(sample: _Dict, color_values: _List[float], show_colorbar: bool, horizontal_colorbar: bool = True) -> _Dict:
    marker = {
        "size": 2,
        "color": color_values,
        "colorscale": _COLORSCALE,
        "cmin": 0,
        "cmax": sample["snp_cap"],
        "showscale": show_colorbar,
    }
    if show_colorbar:
        if horizontal_colorbar:
            marker["colorbar"] = {
                "title": "SNP N",
                "orientation": "h",
                "x": 0.70,
                "y": -0.22,
                "len": 0.30,
                "thickness": 12,
            }
        else:
            # 兼容较旧 Plotly：如果不支持横向 colorbar，就放到图右侧并与图例错开。
            marker["colorbar"] = {
                "title": "SNP N",
                "x": 1.00,
                "y": 0.45,
                "len": 0.60,
                "thickness": 12,
            }
    return marker


def _add_chrom_lines(fig, chrom_offsets: _Dict[str, int], row=None, col=1):
    for offset in chrom_offsets.values():
        kwargs = {
            "x": offset,
            "line_width": 0.5,
            "line_dash": "dash",
            "line_color": "black",
        }
        if row is None:
            fig.add_vline(**kwargs)
        else:
            fig.add_vline(row=row, col=col, **kwargs)


def _apply_single_axis_layout(fig, tick_vals: _List[float], tick_texts: _List[str], total_length: int, height: int, width: int, showlegend: bool, title: str = ""):
    fig.update_layout(
        template="simple_white",
        plot_bgcolor="white",
        paper_bgcolor="white",
        hovermode="closest",
        width=width,
        height=height,
        margin={"l": 70, "r": 230 if showlegend else 90, "t": 40 if title else 25, "b": 95},
        showlegend=showlegend,
        title={"text": title, "x": 0.5} if title else None,
        font={"size": 15},
        legend={"x": 1.02, "y": 1, "xanchor": "left", "yanchor": "top"},
    )
    fig.update_xaxes(
        tickmode="array",
        tickvals=tick_vals,
        ticktext=tick_texts,
        range=[0, max(total_length, 1)],
        showgrid=False,
        automargin=True,
        tickfont={"size": 15},
    )
    fig.update_yaxes(showgrid=False, tickfont={"size": 15})


def _add_sample_trace(fig, sample: _Dict, arrays: _Dict, showlegend: bool, show_colorbar: bool, row=None):
    marker = _marker_style(sample, arrays["color"], show_colorbar)
    try:
        trace = _go.Scattergl(
            x=arrays["x"],
            y=arrays["y"],
            mode="markers",
            name=sample["sample"],
            hoverinfo="text",
            hovertext=arrays["hover"],
            marker=marker,
            showlegend=showlegend,
        )
    except ValueError as exc:
        if show_colorbar and "orientation" in str(exc):
            marker = _marker_style(sample, arrays["color"], show_colorbar, horizontal_colorbar=False)
            trace = _go.Scattergl(
                x=arrays["x"],
                y=arrays["y"],
                mode="markers",
                name=sample["sample"],
                hoverinfo="text",
                hovertext=arrays["hover"],
                marker=marker,
                showlegend=showlegend,
            )
        else:
            raise
    if row is None:
        fig.add_trace(trace)
    else:
        fig.add_trace(trace, row=row, col=1)


def _write_single_sample_html(sample: _Dict, output_dir: str):
    chroms, _, chrom_offsets, tick_vals, tick_texts, total_length = _build_chrom_axes([sample], use_global_lengths=False)
    arrays = _build_plot_arrays(sample, chroms, chrom_offsets)

    fig = _go.Figure()
    _add_sample_trace(fig, sample, arrays, showlegend=False, show_colorbar=True)
    _add_chrom_lines(fig, chrom_offsets)
    _apply_single_axis_layout(
        fig,
        tick_vals,
        tick_texts,
        total_length,
        height=500,
        width=1800,
        showlegend=False,
    )

    out_path = _os.path.join(output_dir, f"bsa_interactive_{_sanitize_filename(sample['sample'])}.html")
    fig.write_html(out_path, include_plotlyjs="cdn")
    return out_path


def _write_combined_html(samples: _List[_Dict], output_dir: str):
    chroms, _, chrom_offsets, tick_vals, tick_texts, total_length = _build_chrom_axes(samples, use_global_lengths=True)

    fig = _go.Figure()
    for idx, sample in enumerate(samples):
        arrays = _build_plot_arrays(sample, chroms, chrom_offsets)
        _add_sample_trace(fig, sample, arrays, showlegend=True, show_colorbar=(idx == 0))

    _add_chrom_lines(fig, chrom_offsets)
    _apply_single_axis_layout(
        fig,
        tick_vals,
        tick_texts,
        total_length,
        height=500,
        width=1800,
        showlegend=True,
        title="Interactive BSA SNP-index",
    )

    out_path = _os.path.join(output_dir, "bsa_interactive_combined.html")
    fig.write_html(out_path, include_plotlyjs="cdn")
    return out_path


def _write_subplots_html(samples: _List[_Dict], output_dir: str):
    chroms, _, chrom_offsets, tick_vals, tick_texts, total_length = _build_chrom_axes(samples, use_global_lengths=True)
    n_samples = len(samples)
    fig = _make_subplots(
        rows=n_samples,
        cols=1,
        shared_xaxes=True,
        vertical_spacing=0.025,
        subplot_titles=[sample["sample"] for sample in samples],
    )

    for idx, sample in enumerate(samples, start=1):
        arrays = _build_plot_arrays(sample, chroms, chrom_offsets)
        _add_sample_trace(fig, sample, arrays, showlegend=True, show_colorbar=(idx == 1), row=idx)
        _add_chrom_lines(fig, chrom_offsets, row=idx)
        fig.update_xaxes(
            tickmode="array",
            tickvals=tick_vals,
            ticktext=tick_texts,
            range=[0, max(total_length, 1)],
            showticklabels=True,
            showgrid=False,
            automargin=True,
            tickfont={"size": 15},
            row=idx,
            col=1,
        )
        fig.update_yaxes(showgrid=False, tickfont={"size": 15}, row=idx, col=1)

    fig.update_layout(
        template="simple_white",
        plot_bgcolor="white",
        paper_bgcolor="white",
        hovermode="closest",
        width=1800,
        height=max(360 * n_samples, 600),
        margin={"l": 70, "r": 230, "t": 45, "b": 95},
        showlegend=True,
        title={"text": "Interactive BSA SNP-index", "x": 0.5},
        font={"size": 15},
        legend={"x": 1.02, "y": 1, "xanchor": "left", "yanchor": "top"},
    )

    out_path = _os.path.join(output_dir, "bsa_interactive_subplots.html")
    fig.write_html(out_path, include_plotlyjs="cdn")
    return out_path


def _main():
    args = _parse_args()
    _os.makedirs(args.output_dir, exist_ok=True)

    if args.sample_labels and len(args.sample_labels) != len(args.plot_tsv):
        print("[ERROR] --sample-labels 的数量必须与 --plot-tsv 文件数量一致。", file=_sys.stderr)
        return 2

    labels = args.sample_labels or [_infer_sample_name(path) for path in args.plot_tsv]

    print(f"[1/4] Reading {len(args.plot_tsv)} snpindex/plot.tsv files...")
    samples = []
    for path, label in zip(args.plot_tsv, labels):
        sample = _load_snpindex_data(path, label)
        samples.append(sample)
        print(f"  - {label}: {sample['point_count']} points, SNP_N 90% cap = {sample['snp_cap']:.2f}")

    print("[2/4] Generating single-sample HTML files...")
    output_paths = []
    for sample in samples:
        output_paths.append(_write_single_sample_html(sample, args.output_dir))

    print("[3/4] Generating combined HTML...")
    output_paths.append(_write_combined_html(samples, args.output_dir))

    print("[4/4] Generating subplots HTML...")
    output_paths.append(_write_subplots_html(samples, args.output_dir))

    print("[Done] Interactive HTML files generated:")
    for path in output_paths:
        print(f"  - {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(_main())

raise SystemExit("interact_html 是命令行脚本，不作为 Python 模块导入。")

# 下面保留的是旧实现，正常命令行运行时不会执行。
"""
生成时间: 2026-04-13
脚本名称: interact_html
脚本作用:
1. 读取多个 BSA plot.tsv 文件
2. 基于染色体计算累计坐标，实现全基因组横坐标展开
3. 使用 Plotly 生成两种交互式可视化网页：
   - combined: 所有群体的折线图叠在同一张图里
   - subplots: 将每个群体分开成上下排列的子图
4. 结合共有峰提取结果 (all_clusters.tsv) 生成半透明带状背景标示候选区间，且可独立在图例层控开关
5. 悬停任一点显示详细信息，并且自动按 SNP_N 大小映射颜色

使用方法:
python interact_html \
  --plot-tsv a.plot.tsv b.plot.tsv \
  --output-dir ./output/interact_html \
  --cluster-tsv ./all_clusters.tsv
"""

import argparse
import csv
import os
import re
from typing import Dict, List, Tuple
import numpy as np

try:
    import plotly.graph_objects as go
    from plotly.subplots import make_subplots
except ImportError:
    print("[ERROR] 必须安装 plotly! 请先执行: pip install plotly")
    import sys
    sys.exit(1)

GENERATED_AT = "2026-04-13"
SAMPLE_RE = re.compile(r"joint_(\d+)_?|(\d+)_new")

def parse_args():
    parser = argparse.ArgumentParser(description="生成交互式的 BSA 结果图(HTML)")
    parser.add_argument("--plot-tsv", nargs="+", required=True, help="多个 BSA plot.tsv 文件路径")
    parser.add_argument("--output-dir", required=True, help="输出目录")
    parser.add_argument("--cluster-tsv", help="共有峰结果文件，用于在图上高亮标示峰区间", default="")
    parser.add_argument("--min-cluster-support", type=int, default=2, help="仅高亮 support>=N 的共有峰")
    return parser.parse_args()

def infer_sample_name(path: str) -> str:
    match = SAMPLE_RE.search(path)
    if match:
        if match.group(1): return match.group(1)
        if match.group(2): return match.group(2)
    return os.path.basename(path).replace(".plot.tsv", "").replace(".tsv", "")

def load_plot_tsv(path: str) -> Tuple[str, List[str], List[int], List[float], List[int]]:
    sample = infer_sample_name(path)
    chroms, pos_arr, delta_arr, snpn_arr = [], [], [], []
    
    with open(path, "r", encoding="utf-8") as f:
        reader = csv.reader(f, delimiter="\t")
        for row in reader:
            if not row or row[0].startswith("#") or len(row) < 7:
                if row and row[0] == "CHROM": continue
                continue
            
            try:
                chrom = row[0]
                pos = int(float(row[1]))
                delta = float(row[5])
                snp_n = int(float(row[6]))
                
                if not np.isnan(delta):
                    chroms.append(chrom)
                    pos_arr.append(pos)
                    delta_arr.append(delta)
                    snpn_arr.append(snp_n)
            except ValueError:
                continue
                
    return sample, chroms, pos_arr, delta_arr, snpn_arr

def calculate_global_axes(all_data):
    # Calculate max lengths of each chrom across all samples
    chrom_max = {}
    for data in all_data:
        chroms, pos_arr = data['chroms'], data['pos']
        for c, p in zip(chroms, pos_arr):
            if c not in chrom_max:
                chrom_max[c] = p
            else:
                chrom_max[c] = max(chrom_max[c], p)
                
    # Sort chromosomes naturally
    sorted_chroms = sorted(chrom_max.keys(), key=lambda c: (len(c), c))
    
    chrom_offsets = {}
    tick_vals = []
    tick_texts = []
    
    current_offset = 0
    for c in sorted_chroms:
        chrom_offsets[c] = current_offset
        length = chrom_max[c]
        tick_vals.append(current_offset + length / 2)
        tick_texts.append(c)
        current_offset += length
        
    return chrom_offsets, current_offset, tick_vals, tick_texts

def add_clusters_to_fig(fig, cluster_tsv, chrom_offsets, min_support, total_length, y_min, y_max, is_subplots, total_rows=1):
    if not cluster_tsv or not os.path.exists(cluster_tsv):
        return

    clusters = []
    with open(cluster_tsv, "r", encoding="utf-8") as f:
        reader = csv.DictReader(f, delimiter="\t")
        for row in reader:
            if int(row["support_count"]) >= min_support:
                clusters.append(row)
                
    # We will use polygon scatters instead of vrects so they can be toggled by a single legend item
    feature_added_to_legend = False
    
    for cl in clusters:
        chrom = cl["chrom"]
        if chrom not in chrom_offsets:
            continue
            
        r_start = chrom_offsets[chrom] + int(cl["region_start"])
        r_end = chrom_offsets[chrom] + int(cl["region_end"])
        
        # Hover format
        hovertext = f"Cluster: {cl['cluster_id']}<br>Support: {cl['support_count']} ({cl['support_samples']})<br>Sign: {cl['sign']}<br>Span: {cl['region_start']}-{cl['region_end']}"
        
        # Single box trace
        x_box = [r_start, r_start, r_end, r_end, r_start]
        y_box = [y_min, y_max, y_max, y_min, y_min]
        
        # If it's the subplot version, we draw the rect on every row
        rows_to_draw = range(1, total_rows + 1) if is_subplots else [None]
        
        for r_idx in rows_to_draw:
            trace = go.Scatter(
                x=x_box, y=y_box,
                fill="toself",
                fillcolor="rgba(255, 0, 0, 0.15)",
                line=dict(width=0),
                hoverinfo="text",
                hovertext=hovertext,
                showlegend=not feature_added_to_legend,
                legendgroup="SharePeak",
                name=f"Share Peak (>= {min_support})",
                mode="lines"
            )
            if is_subplots and r_idx is not None:
                fig.add_trace(trace, row=r_idx, col=1)
            else:
                fig.add_trace(trace)
            feature_added_to_legend = True

def main():
    args = parse_args()
    os.makedirs(args.output_dir, exist_ok=True)
    
    print(f"[1/4] Reading data from {len(args.plot_tsv)} plot.tsv files...")
    all_data = []
    global_min_snp, global_max_snp = 1000000, 0
    global_min_delta, global_max_delta = 0, 0
    
    for path in args.plot_tsv:
        sample, c, p, d, s = load_plot_tsv(path)
        all_data.append({'sample': sample, 'chroms': c, 'pos': p, 'delta': d, 'snp': s})
        if s:
            global_min_snp = min(global_min_snp, min(s))
            global_max_snp = max(global_max_snp, max(s))
        if d:
            global_min_delta = min(global_min_delta, min(d))
            global_max_delta = max(global_max_delta, max(d))
            
    print(f"[2/4] Calculating genome cumulative coordinates...")
    chrom_offsets, max_x, tick_vals, tick_texts = calculate_global_axes(all_data)
    
    # Calculate cumulative X internally
    for data in all_data:
        data['x_cum'] = [p + chrom_offsets[c] for c, p in zip(data['chroms'], data['pos'])]
        data['hover'] = [
            f"Sample: {data['sample']}<br>Chrom: {c}<br>Pos: {p:,}<br>DELTA: {d:.4f}<br>SNP N: {s}"
            for c, p, d, s in zip(data['chroms'], data['pos'], data['delta'], data['snp'])
        ]
        
    y_min, y_max = global_min_delta - 0.05, global_max_delta + 0.05
    
    layout_common = dict(
        xaxis=dict(
            tickmode="array",
            tickvals=tick_vals,
            ticktext=tick_texts,
            showgrid=False
        ),
        plot_bgcolor="white",
        hovermode="closest",
        title="Interactive BSA DELTA_SNP_INDEX"
    )

    # ==========================
    # 1. Combined Version
    # ==========================
    print("[3/4] Generating Combined Interactive HTML...")
    fig_combined = go.Figure()
    
    for idx, data in enumerate(all_data):
        fig_combined.add_trace(go.Scattergl(
            x=data['x_cum'],
            y=data['delta'],
            mode='markers',
            name=data['sample'],
            hoverinfo='text',
            hovertext=data['hover'],
            marker=dict(
                size=3,
                color=data['snp'],
                colorscale='Plasma',
                cmin=global_min_snp,
                cmax=global_max_snp,
                showscale=(idx == 0),
                colorbar=dict(title="SNP N") if idx == 0 else None
            )
        ))
        
    add_clusters_to_fig(fig_combined, args.cluster_tsv, chrom_offsets, args.min_cluster_support, max_x, y_min, y_max, False)
    
    # Add vertical lines for chromosomes
    for c, offset in chrom_offsets.items():
        if offset > 0:
            fig_combined.add_vline(x=offset, line_width=1, line_dash="dash", line_color="gray")
            
    fig_combined.update_layout(**layout_common, yaxis_title="DELTA_SNP_INDEX")
    
    comb_out = os.path.join(args.output_dir, "bsa_interactive_combined.html")
    fig_combined.write_html(comb_out, include_plotlyjs="cdn")
    print(f" -> {comb_out}")

    # ==========================
    # 2. Subplots Version
    # ==========================
    print("[4/4] Generating Subplots Interactive HTML...")
    n_samples = len(all_data)
    fig_sub = make_subplots(rows=n_samples, cols=1, shared_xaxes=True, vertical_spacing=0.02, subplot_titles=[d['sample'] for d in all_data])
    
    for idx, data in enumerate(all_data):
        fig_sub.add_trace(go.Scattergl(
            x=data['x_cum'],
            y=data['delta'],
            mode='markers',
            name=data['sample'],
            hoverinfo='text',
            hovertext=data['hover'],
            legendgroup=data['sample'],
            marker=dict(
                size=3,
                color=data['snp'],
                colorscale='Plasma',
                cmin=global_min_snp,
                cmax=global_max_snp,
                showscale=False  # Hide colorbars to save space in subplots
            )
        ), row=idx+1, col=1)
        
        # Add vertical lines to each subplot
        for c, offset in chrom_offsets.items():
            if offset > 0:
                fig_sub.add_vline(x=offset, line_width=1, line_dash="dash", line_color="gray", row=idx+1, col=1)
                
    add_clusters_to_fig(fig_sub, args.cluster_tsv, chrom_offsets, args.min_cluster_support, max_x, y_min, y_max, True, n_samples)
    
    layout_sub = layout_common.copy()
    layout_sub['height'] = 250 * n_samples  # 动态高度
    for i in range(1, n_samples+1):
        fig_sub.update_yaxes(title_text="DELTA", row=i, col=1, range=[y_min, y_max])
        
    fig_sub.update_layout(**layout_sub)
    sub_out = os.path.join(args.output_dir, "bsa_interactive_subplots.html")
    fig_sub.write_html(sub_out, include_plotlyjs="cdn")
    print(f" -> {sub_out}")
    print("[Done] Interactive plots generated successfully.")

if __name__ == "__main__":
    main()
