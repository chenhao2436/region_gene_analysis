#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
生成时间: 2026-03-26
脚本名称: gene_out
脚本作用:
1. 将交集基因与拟南芥 RBH 结果和 TAIR 功能注释合并
2. 将 Annovar 的 variant_function / exonic_variant_function 整理成便于阅读的表格
3. 输出按基因汇总的变异注释结果

输入文件:
- gene_common.at_least_2.tsv
- gene_common.all_5.tsv
- AT_Canz_reciprocal_best_hits.txt
- TAIR_gene.annotate.unique_v1.2
- gene_region_vcf.<label>.variant_function
- gene_region_vcf.<label>.exonic_variant_function

输出文件:
- gene_out.at_least_2.genes.annotated.tsv
- gene_out.all_5.genes.annotated.tsv
- gene_out.at_least_2.variant.detail.tsv
- gene_out.all_5.variant.detail.tsv
- gene_out.at_least_2.variant.by_gene.tsv
- gene_out.all_5.variant.by_gene.tsv

使用方法:
python gene_out \
  --atleast2-table gene_common.at_least_2.tsv \
  --all5-table gene_common.all_5.tsv \
  --rbh-file AT_Canz_reciprocal_best_hits.txt \
  --tair-annotation TAIR_gene.annotate.unique_v1.2 \
  --annovar-prefix-atleast2 ./output/gene_region_vcf/at_least_2/gene_region_vcf.at_least_2 \
  --annovar-prefix-all5 ./output/gene_region_vcf/all_5/gene_region_vcf.all_5 \
  --output-dir ./output/gene_out
"""

from __future__ import annotations

import argparse
import csv
import os
import re
from collections import defaultdict
from typing import Dict, Iterable, List, Sequence, Set


GENERATED_AT = "2026-03-26"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="整合交集基因、拟南芥功能和 Annovar 变异注释。")
    parser.add_argument("--atleast2-table", required=True, help="gene_common.at_least_2.tsv")
    parser.add_argument("--all5-table", required=True, help="gene_common.all_5.tsv")
    parser.add_argument("--rbh-file", required=True, help="辣椒基因到拟南芥基因的 RBH 结果")
    parser.add_argument("--tair-annotation", required=True, help="TAIR 注释表")
    parser.add_argument("--annovar-prefix-atleast2", required=True, help="at_least_2 的 annovar 输出前缀")
    parser.add_argument("--annovar-prefix-all5", required=True, help="all_5 的 annovar 输出前缀")
    parser.add_argument("--output-dir", required=True, help="输出目录")
    return parser.parse_args()


def read_tsv(path: str) -> List[Dict[str, str]]:
    with open(path, "r", encoding="utf-8") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        return list(reader)


def write_tsv(path: str, rows: Sequence[Dict[str, object]], fieldnames: Sequence[str]) -> None:
    with open(path, "w", encoding="utf-8", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=fieldnames, delimiter="\t")
        writer.writeheader()
        for row in rows:
            writer.writerow(row)


def load_rbh(path: str) -> Dict[str, Dict[str, str]]:
    mapping: Dict[str, Dict[str, str]] = {}
    with open(path, "r", encoding="utf-8") as handle:
        for line in handle:
            if not line.strip() or line.startswith("#"):
                continue
            parts = line.strip().split()
            if len(parts) < 3:
                continue
            canz_gene, tair_gene, score = parts[0], parts[1], parts[2]
            record = {"tair_gene_full": tair_gene, "tair_gene_base": tair_gene.split(".", 1)[0], "rbh_score": score}
            mapping[canz_gene] = record
            mapping[canz_gene.split(".", 1)[0]] = record
    return mapping


def load_tair(path: str) -> Dict[str, str]:
    mapping: Dict[str, str] = {}
    with open(path, "r", encoding="utf-8") as handle:
        for line in handle:
            if not line.strip() or line.startswith("#"):
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) >= 2:
                mapping[parts[0].split(".", 1)[0]] = parts[1]
    return mapping


def annotate_gene_rows(rows: Sequence[Dict[str, str]], rbh_map: Dict[str, Dict[str, str]], tair_map: Dict[str, str]) -> List[Dict[str, object]]:
    annotated: List[Dict[str, object]] = []
    for row in rows:
        gene_id = row["gene_id"]
        gene_id_base = row.get("gene_id_base", gene_id.split(".", 1)[0])
        rbh = rbh_map.get(gene_id) or rbh_map.get(gene_id_base, {})
        tair_base = rbh.get("tair_gene_base", ".")
        tair_desc = tair_map.get(tair_base, ".") if tair_base != "." else "."
        annotated.append({**row, "tair_gene_full": rbh.get("tair_gene_full", "."), "tair_gene_base": tair_base, "rbh_score": rbh.get("rbh_score", "."), "tair_description": tair_desc})
    return annotated


def extract_gene_tokens(text: str) -> Set[str]:
    if not text or text in {".", "NA"}:
        return set()
    tokens = set()
    for token in re.split(r"[,;() ]+", text):
        token = token.strip()
        if token:
            tokens.add(token)
            tokens.add(token.split(".", 1)[0])
    return tokens


def load_variant_details(variant_function_path: str, exonic_variant_path: str, gene_ids: Iterable[str]) -> List[Dict[str, object]]:
    gene_id_set = set(gene_ids)
    if not os.path.exists(variant_function_path) or os.path.getsize(variant_function_path) == 0:
        return []
    exonic_map: Dict[tuple, List[Dict[str, str]]] = defaultdict(list)

    if os.path.exists(exonic_variant_path):
        with open(exonic_variant_path, "r", encoding="utf-8") as handle:
            reader = csv.reader(handle, delimiter="\t")
            for row in reader:
                if len(row) < 8:
                    continue
                line_id, exonic_func, aa_change, chrom, start, end, ref, alt = row[:8]
                exonic_map[(chrom, start, end, ref, alt)].append({"line_id": line_id, "exonic_function": exonic_func, "aa_change": aa_change})

    details: List[Dict[str, object]] = []
    with open(variant_function_path, "r", encoding="utf-8") as handle:
        reader = csv.reader(handle, delimiter="\t")
        for row in reader:
            if len(row) < 7:
                continue
            func, gene_text, chrom, start, end, ref, alt = row[:7]
            tokens = extract_gene_tokens(gene_text)
            matched_genes = sorted([gene_id for gene_id in gene_id_set if gene_id in tokens or gene_id.split(".", 1)[0] in tokens])
            if not matched_genes:
                continue
            exonic_info = exonic_map.get((chrom, start, end, ref, alt), [])
            exonic_func = "|".join(item["exonic_function"] for item in exonic_info) if exonic_info else "."
            aa_change = "|".join(item["aa_change"] for item in exonic_info) if exonic_info else "."
            for gene_id in matched_genes:
                details.append({"gene_id": gene_id, "variant_function": func, "annotated_gene_text": gene_text, "chrom": chrom, "start": start, "end": end, "ref": ref, "alt": alt, "exonic_function": exonic_func, "aa_change": aa_change})
    details.sort(key=lambda item: (item["gene_id"], item["chrom"], int(item["start"]), item["ref"], item["alt"]))
    return details


def summarise_variants(detail_rows: Sequence[Dict[str, object]], gene_rows: Sequence[Dict[str, object]]) -> List[Dict[str, object]]:
    grouped: Dict[str, List[Dict[str, object]]] = defaultdict(list)
    for row in detail_rows:
        grouped[str(row["gene_id"])].append(row)
    summary_rows: List[Dict[str, object]] = []
    for gene_row in gene_rows:
        gene_id = str(gene_row["gene_id"])
        variants = grouped.get(gene_id, [])
        summary_rows.append(
            {
                "gene_id": gene_id,
                "gene_name": gene_row.get("gene_name", "."),
                "chrom": gene_row.get("chrom", "."),
                "gene_start": gene_row.get("gene_start", "."),
                "gene_end": gene_row.get("gene_end", "."),
                "support_count": gene_row.get("support_count", "."),
                "supporting_samples": gene_row.get("supporting_samples", "."),
                "overall_direction_label": gene_row.get("overall_direction_label", "."),
                "tair_gene_full": gene_row.get("tair_gene_full", "."),
                "tair_description": gene_row.get("tair_description", "."),
                "variant_count": len(variants),
                "exonic_variant_count": sum(1 for row in variants if row["exonic_function"] != "."),
                "variant_types": ",".join(sorted({str(row["variant_function"]) for row in variants})) if variants else ".",
                "exonic_variant_types": ",".join(sorted({str(row["exonic_function"]) for row in variants if row["exonic_function"] != "."})) if variants else ".",
            }
        )
    return summary_rows


def process_one_set(label: str, gene_table_path: str, annovar_prefix: str, rbh_map: Dict[str, Dict[str, str]], tair_map: Dict[str, str], output_dir: str) -> None:
    gene_rows = read_tsv(gene_table_path)
    annotated_gene_rows = annotate_gene_rows(gene_rows, rbh_map, tair_map)
    annotated_gene_path = os.path.join(output_dir, f"gene_out.{label}.genes.annotated.tsv")
    write_tsv(annotated_gene_path, annotated_gene_rows, list(annotated_gene_rows[0].keys()) if annotated_gene_rows else ["gene_id"])

    detail_rows = load_variant_details(annovar_prefix + ".variant_function", annovar_prefix + ".exonic_variant_function", [row["gene_id"] for row in gene_rows])
    variant_detail_path = os.path.join(output_dir, f"gene_out.{label}.variant.detail.tsv")
    write_tsv(variant_detail_path, detail_rows, ["gene_id", "variant_function", "annotated_gene_text", "chrom", "start", "end", "ref", "alt", "exonic_function", "aa_change"])

    summary_rows = summarise_variants(detail_rows, annotated_gene_rows)
    variant_by_gene_path = os.path.join(output_dir, f"gene_out.{label}.variant.by_gene.tsv")
    write_tsv(variant_by_gene_path, summary_rows, ["gene_id", "gene_name", "chrom", "gene_start", "gene_end", "support_count", "supporting_samples", "overall_direction_label", "tair_gene_full", "tair_description", "variant_count", "exonic_variant_count", "variant_types", "exonic_variant_types"])

    print(f"[OK] {label} annotated genes: {annotated_gene_path}")
    print(f"[OK] {label} variant details: {variant_detail_path}")
    print(f"[OK] {label} variant by gene: {variant_by_gene_path}")


def main() -> None:
    args = parse_args()
    os.makedirs(args.output_dir, exist_ok=True)
    rbh_map = load_rbh(args.rbh_file)
    tair_map = load_tair(args.tair_annotation)
    process_one_set("at_least_2", args.atleast2_table, args.annovar_prefix_atleast2, rbh_map, tair_map, args.output_dir)
    process_one_set("all_5", args.all5_table, args.annovar_prefix_all5, rbh_map, tair_map, args.output_dir)
    print(f"[OK] generated at: {GENERATED_AT}")


if __name__ == "__main__":
    main()
